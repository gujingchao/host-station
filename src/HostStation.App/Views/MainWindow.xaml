<Window x:Class="HostStation.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Host Station" Height="640" Width="960">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="Host Station" Margin="0,0,0,12"/>
    <TabControl>
      <TabItem Header="Devices">
        <TextBlock Margin="8" Text="Device / tag views (wayly) — protocol samples bind via queue."/>
      </TabItem>
      <TabItem Header="Trends">
        <TextBlock Margin="8" Text="Realtime trends placeholder."/>
      </TabItem>
      <TabItem Header="Alarms">
        <TextBlock Margin="8" Text="Alarm list placeholder."/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
